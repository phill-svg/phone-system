{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "test": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "test"
      },
      "channel": "test"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./credentials/play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "ascAppId": "6806023125",
        "ascApiKeyPath": "./credentials/AuthKey_U93QSZVV4W.p8",
        "ascApiKeyId": "U93QSZVV4W",
        "ascApiKeyIssuerId": "f5266cfa-b509-4c08-85ea-145c251cdc35"
      }
    }
  }
}
