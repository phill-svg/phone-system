{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "test": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "test"
      },
      "channel": "test"
    },
    "production": {
      "channel": "production"
    }
  }
}
