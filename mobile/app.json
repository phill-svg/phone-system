{
  "expo": {
    "name": "TCB Phone",
    "slug": "mobile",
    "owner": "skiptoolow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-appstore.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "TCB Phone needs microphone access to make and receive calls.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "bundleIdentifier": "au.com.tcbpestcontrolcanberra.tcbphone",
      "buildNumber": "2"
    },
    "android": {
      "package": "au.com.tcbpestcontrolcanberra.tcbphone",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tcb-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/tcb-logo.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#D32F2F"
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/1a1e7d49-ffbb-4867-915e-2e153db8aa0a"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a1e7d49-ffbb-4867-915e-2e153db8aa0a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
