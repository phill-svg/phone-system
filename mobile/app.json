{
  "expo": {
    "name": "TCB Phone",
    "slug": "mobile",
    "owner": "skiptoolow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tcb-logo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "au.com.tcbpestcontrolcanberra.tcbphone",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/tcb-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tcb-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/tcb-logo.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      "expo-audio"
    ],
    "updates": {
      "enabled": false
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a1e7d49-ffbb-4867-915e-2e153db8aa0a"
      }
    }
  }
}
