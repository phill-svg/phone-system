{
  "name": "tcb-phone-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Desktop shell for the TCB staff admin dashboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --dir --x64"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4"
  },
  "build": {
    "appId": "au.com.tcbpestcontrolcanberra.tcbphone",
    "productName": "TCB Phone",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "TCB-Phone-Setup-${version}.exe"
    }
  }
}
