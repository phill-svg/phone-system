{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tcb-voip",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tcb-voip-db",
      "database_id": "c6d72eb4-9a3d-43cb-9678-69e5151b81fb",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CALL_SESSION", "class_name": "CallSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CallSession"] }],
  "routes": [{ "pattern": "phone.tcbpestcontrolcanberra.com.au", "custom_domain": true }],
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "AUDIO_ASSETS", "bucket_name": "tcb-voip-audio" }],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "TWILIO_FROM_NUMBER": "+61866108941",
    "TWILIO_SMS_NUMBER": "+61485034869",
    "TWILIO_TWIML_APP_SID": "AP37a6e4263508806aa37efaf19285d2ed",
    "TWILIO_PUSH_CREDENTIAL_SID_ANDROID": "CRa514b67c428755dd962c50503041de9a",
    "AUTH_FROM_EMAIL": "noreply@mail.tcbpestcontrolcanberra.com.au"
  }
}
