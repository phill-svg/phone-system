{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tcb-voip",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tcb-voip-db",
      "database_id": "c6d72eb4-9a3d-43cb-9678-69e5151b81fb",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CALL_SESSION", "class_name": "CallSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CallSession"] }],
  "r2_buckets": [{ "binding": "AUDIO_ASSETS", "bucket_name": "tcb-voip-audio" }],
  "vars": {
    "TWILIO_ACCOUNT_SID": "REPLACE_ME",
    "CF_ACCESS_TEAM_DOMAIN": "phill-abb.cloudflareaccess.com",
    "CF_ACCESS_AUD": "823cf222fdebd401866183b13a524c76a9f5a9cc009195c2091081c39e569161"
  }
}
